# Binaries and bundled runtime
manager/Backend-Apps/
manager/_internal/
manager/dist/
manager/build/
manager/*.exe
firmware/

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
*.egg-info/

# VM state (user data - never commit)
vms/
macOS-disks/
logs/
run/

# Build artifacts and reference/source trees (not part of the app)
build/
dist/
refs/
windows-smoke/
guestchan/
probe/
kexts/

# Firmware / disk / log artifacts
*.img
*.qcow2
*.fd
*.iso
*.dmg
*.log
*.ppm
*.bak-*

# Editor / OS noise
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.lnk
*.swp
.idea/
.vscode/
