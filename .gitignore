# Binaries and bundled runtime
manager/Backend-Apps/*
!manager/Backend-Apps/PowerShell7/
!manager/Backend-Apps/Python/
!manager/Backend-Apps/Scripts/
manager/Backend-Apps/*/Backend-Apps/
manager/Backend-Apps/*/dist/
manager/Backend-Apps/*/build/
manager/Backend-Apps/*/__pycache__/

# Keep the actual executables inside the imported Backend-Apps folders
!manager/Backend-Apps/PowerShell7/*.exe
!manager/Backend-Apps/Python/*.exe
firmware/

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
*.egg-info/

# Keeping the empty state-tracking folders in git via .gitkeep.
# Actual user data inside them (disks, VM configs, logs) stays ignored below.

# Build artifacts and reference/source trees (not part of the app)
/build/
/dist/
guestchan/
probe/
kexts/

# Firmware / disk / log artifacts
*.img
*.qcow2
*.fd
*.iso
*.dmg
*.log
*.ppm
*.bak-*

# User data inside the tracked folders (keep folders, ignore contents)
vms/*
!vms/.gitkeep
macOS-disks/*
!macOS-disks/.gitkeep
run/*
!run/.gitkeep
refs/*
!refs/.gitkeep
windows-smoke/*
!windows-smoke/.gitkeep
logs/

# Exception: the manager's packaged build outputs and staged kexts are
# intentionally committed to this repository (same folder names).
!manager/kexts/
!manager/dist/
!manager/_internal/
!manager/__pycache__/
!manager/__pycache__/*.pyc
!manager/__pycache__/*.pyo
!manager/**/*.pyd

# Editor / OS noise
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.lnk
*.swp
.idea/
.vscode/
